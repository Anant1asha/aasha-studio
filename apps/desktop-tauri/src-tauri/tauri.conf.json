{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "AASHA Studio",
  "version": "1.0.0",
  "identifier": "org.aasha.studio",
  "build": {
    "beforeDevCommand": "npm run --workspace=apps/studio-ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run --workspace=apps/studio-ui build",
    "frontendDist": "../studio-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AASHA Studio — AI Learning Transformation",
        "width": 1100,
        "height": 780,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
